FROM apache/airflow:2.8.1-python3.10

USER root
# Instalujemy git (do DVC) oraz curl, a następnie pobieramy najnowszego klienta Dockera
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && curl -fsSL https://get.docker.com | sh \
    && apt-get autoremove -yqq --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow
# Dodano wsparcie dla bazy Postgres i DVC (Google Drive)
RUN pip install --no-cache-dir "dvc[gdrive]" apache-airflow-providers-docker apache-airflow-providers-postgres psycopg2-binary pyOpenSSL opencv-python-headless requests