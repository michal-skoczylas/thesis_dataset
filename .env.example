# ==========================================
# Konfiguracja srodowiska - Thesis Dataset
# ==========================================

# Nazwa projektu dockera (zapewnia spojne nazewnictwo wolumenow na kazdej maszynie)
COMPOSE_PROJECT_NAME=dane

# Adres URL do API Label Studio (z punktu widzenia uruchamianych skryptow)
# Jesli skrypty odpalasz lokalnie na Macu/PC: http://localhost:8081
# Jesli wewnatrz kontenera Dockera: http://label-studio:8080
LABEL_STUDIO_URL=http://localhost:8081

# Token API uzytkownika z Label Studio (znajdziesz go w UI w Account & Settings)
LABEL_STUDIO_TOKEN=twoj_token_label_studio

# ID projektu w Label Studio (domyslnie 1)
LABEL_STUDIO_PROJECT_ID=1

# Port zewnetrzny dla kontenera Label Studio
LABEL_STUDIO_PORT=8081

# Sciezka do glownego katalogu danych (wzgledna lub bezwzgledna)
DATA_DIR=data
